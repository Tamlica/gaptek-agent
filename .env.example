# Copy to .env and fill in. Real environment variables override this file.

# Models as "provider:model". Providers: anthropic, openai, gemini, openrouter, groq, deepseek, ollama
# Keep the tester small/cheap on purpose; the analyst should be strong.
GAPTEK_TESTER_MODEL=anthropic:claude-haiku-5-5
GAPTEK_ANALYST_MODEL=anthropic:claude-opus-5-5
# Examples:
# GAPTEK_TESTER_MODEL=openai:gpt-5-mini
# GAPTEK_TESTER_MODEL=gemini:gemini-2.5-flash
# GAPTEK_TESTER_MODEL=openrouter:meta-llama/llama-3.3-70b-instruct
# GAPTEK_TESTER_MODEL=ollama:qwen3:8b

# API keys: only the ones for providers you use
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=
# GROQ_API_KEY=
# DEEPSEEK_API_KEY=

# Optional: override a provider's endpoint, as <PROVIDER>_BASE_URL.
# OPENAI_BASE_URL points "openai:" at any other OpenAI-compatible server (vLLM, LM Studio, ...).
# OPENAI_BASE_URL=http://localhost:1234/v1
# OLLAMA_BASE_URL=http://192.168.1.10:11434/v1
